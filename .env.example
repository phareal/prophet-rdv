# Variables interpolées par Docker Compose lui-même (${VAR} dans
# docker-compose.cms.yml) : elles doivent vivre dans un .env à la racine du
# dépôt, lu par `docker compose`, jamais par les conteneurs. `env_file:`
# n'alimente que l'environnement d'un conteneur, pas l'interpolation.
#
# Les variables applicatives de WordPress (secrets, SMTP, clés Google/YouTube,
# DB_HOST…) vivent séparément dans cms/.env — voir cms/.env.example.

# Domaine servi par Caddy et contact pour Let's Encrypt (production uniquement)
DOMAIN=votre-domaine.com
ACME_EMAIL=vous@exemple.com

# Base MySQL (doit correspondre à DB_NAME/DB_USER/DB_PASSWORD dans cms/.env)
DB_NAME=prophet
DB_USER=prophet
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
